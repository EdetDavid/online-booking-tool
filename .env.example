# Local development defaults. Never put real credentials in this file.
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# PostgreSQL is required in production. Leave blank locally to use SQLite.
DATABASE_URL=
DATABASE_CONN_MAX_AGE=0
DATABASE_CONN_HEALTH_CHECKS=False
DATABASE_SSL_REQUIRE=False

# Proxy and browser security. Production-safe defaults are applied in production.
TRUST_X_FORWARDED_PROTO=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Backblaze B2 media storage. Required in production.
# Set this to True only after configuring all required B2 values below.
USE_B2_STORAGE=False
B2_BUCKET_NAME=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_REGION=
# Optional; derived as https://s3.<B2_REGION>.backblazeb2.com when blank.
B2_ENDPOINT_URL=
B2_MEDIA_LOCATION=media
B2_QUERYSTRING_AUTH=True
B2_QUERYSTRING_EXPIRE=3600
B2_FILE_OVERWRITE=False
B2_ADDRESSING_STYLE=path
# Only for a public bucket routed through a configured CDN/custom domain.
B2_CUSTOM_DOMAIN=

# Flight search.
USE_LIVE_FLIGHT_API=False
FLIGHT_SEARCH_PROVIDER=duffel
DUFFEL_ACCESS_TOKEN=
DUFFEL_API_BASE_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2
DUFFEL_SUPPLIER_TIMEOUT_MS=15000
FLIGHT_SEARCH_TIMEOUT_SECONDS=25
FLIGHT_SEARCH_CACHE_SECONDS=60
FLIGHT_SEARCH_RELAX_TLS_STRICT=False
ALLOW_DUFFEL_TEST_DATA=True

# Hotel search. Use "local" without live Amadeus credentials.
USE_LIVE_HOTEL_API=False
HOTEL_SEARCH_PROVIDER=local
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test
ALLOW_HOTEL_TEST_DATA=True
HOTEL_SEARCH_TIMEOUT_SECONDS=30
HOTEL_SEARCH_CACHE_SECONDS=300
MIN_HOTEL_RESULTS=12

# Email. Production defaults to SES; local development uses the console backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST_USER=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=
EMAIL_FALLBACK_BACKEND=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_SESSION_TOKEN=
AWS_SES_REGION_NAME=us-east-1
AWS_SES_REGION_ENDPOINT=email.us-east-1.amazonaws.com
# Optional Brevo alternative: set EMAIL_BACKEND to the custom Brevo backend.
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Online Booking Tool

# Notification routing.
ADMIN_EMAIL_RECIPIENTS=
STAFF_EMAIL_RECIPIENTS=
TRAVEL_AGENCY_EMAIL_RECIPIENTS=
ROLE_EMAIL_FALLBACK_RECIPIENTS=
FLIGHT_APPROVAL_REQUEST_RECIPIENT_ROLES=admin
BOOKING_NOTIFICATION_RECIPIENT_ROLES=travel_agency
HOTEL_BOOKING_NOTIFICATION_RECIPIENT_ROLES=travel_agency
TRAVEL_AGENCY_DEFAULT_COMPANY_CODE=OBT1234
